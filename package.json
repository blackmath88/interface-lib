{
  "name": "interface-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node --import tsx server/http.ts",
    "mcp:stdio": "node --import tsx server/stdio.ts",
    "test:mcp": "node --import tsx tests/mcp.ts",
    "new-project": "node scripts/new-project.mjs",
    "review:brief": "node scripts/review-brief.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.168.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
